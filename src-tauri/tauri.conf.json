{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ritmo",
  "version": "0.1.0",
  "identifier": "app.ritmo.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Ritmo",
        "url": "index.html",
        "width": 356,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visible": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Tu día, tus reuniones y tu enfoque",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0N0ZCMjdBRDEwQUY2NTUKUldSVjlnclJlckovMUdRK2V3QkhQbkUremtSSUpHdGlSelhENkpiUkZPQ0lxT2lDckc5czUrMWQK",
      "endpoints": [
        "https://github.com/joshepw/ritmo-tauri/releases/latest/download/latest.json"
      ]
    }
  }
}
